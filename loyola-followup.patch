+import { describe, expect, it, vi } from "vitest";
+import { memoizeRequester } from "../src/lib/memoized-requester.js";
+import type { LRMSRequester } from "../src/upstream/lrms.client.js";
+
+function fakeInner() {
+  const inner = {
+    get: vi.fn(async (url: string) => ({ data: `GET:${url}` })),
+    post: vi.fn(async (url: string, body?: unknown) => ({
+      data: `POST:${url}:${body instanceof URLSearchParams ? body.toString() : ""}`,
+    })),
+  };
+  return inner as typeof inner & LRMSRequester;
+}
+
+describe("memoizeRequester", () => {
+  it("shares one call between identical GETs, including parallel ones", async () => {
+    const inner = fakeInner();
+    const lrms = memoizeRequester(inner);
+
+    const [a, b] = await Promise.all([lrms.get("/profile"), lrms.get("/profile")]);
+    await lrms.get("/profile");
+
+    expect(a.data).toBe(b.data);
+    expect(inner.get).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps different URLs and different POST bodies separate", async () => {
+    const inner = fakeInner();
+    const lrms = memoizeRequester(inner);
+
+    await lrms.get("/a");
+    await lrms.get("/b");
+    await lrms.post("/p", new URLSearchParams({ id: "1" }));
+    await lrms.post("/p", new URLSearchParams({ id: "2" }));
+    await lrms.post("/p", new URLSearchParams({ id: "1" }));
+
+    expect(inner.get).toHaveBeenCalledTimes(2);
+    expect(inner.post).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not remember failures, so a retry reaches the ERP", async () => {
+    const inner = fakeInner();
+    inner.get.mockRejectedValueOnce(new Error("boom"));
+    const lrms = memoizeRequester(inner);
+
+    await expect(lrms.get("/x")).rejects.toThrow("boom");
+    await expect(lrms.get("/x")).resolves.toEqual({ data: "GET:/x" });
+    expect(inner.get).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/backend/tests/portal-v2.controller.test.ts b/backend/tests/portal-v2.controller.test.ts
new file mode 100644
index 0000000..87890f2
--- /dev/null
+++ b/backend/tests/portal-v2.controller.test.ts
@@ -0,0 +1,121 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// Saved items live in MongoDB; the controller test must not need a database.
+vi.mock("../src/services/platform.service.js", () => ({
+  PlatformService: class {
+    async list() {
+      return [{ id: "a1", title: "Saved assignment" }];
+    }
+  },
+}));
+
+import { portalV2Controller } from "../src/controllers/portal-v2.controller.js";
+import { erpResponseCache } from "../src/lib/erp-cache.js";
+
+interface FakeRes {
+  locals: Record<string, unknown>;
+  statusCode: number;
+  body?: Record<string, any>;
+  setHeader: () => void;
+  status: (code: number) => FakeRes;
+  json: (body: Record<string, any>) => FakeRes;
+}
+
+function makeRes(lrmsClient: unknown): FakeRes {
+  const res: FakeRes = {
+    locals: {
+      user: { id: "u1" },
+      userDocument: { _id: { toHexString: () => "u1" }, erpCredential: {} },
+      lrmsClient,
+    },
+    statusCode: 200,
+    setHeader: () => undefined,
+    status(code) {
+      res.statusCode = code;
+      return res;
+    },
+    json(body) {
+      res.body = body;
+      return res;
+    },
+  };
+  return res;
+}
+
+const call = (res: FakeRes, section: string, query: Record<string, string> = {}) =>
+  portalV2Controller.get({ params: { section }, query } as never, res as never);
+
+beforeEach(() => {
+  erpResponseCache.clear();
+  vi.spyOn(console, "error").mockImplementation(() => undefined);
+});
+afterEach(() => vi.restoreAllMocks());
+
+describe("PortalV2Controller.get", () => {
+  it("never writes a user's saved items into the shared cached dashboard", async () => {
+    const cached = { dashboard: { name: "Joe" }, attendance: { pct: 80 } };
+    erpResponseCache.set("u1:v2:dashboard", { status: "success", data: cached }, 60_000);
+    const erp = { get: vi.fn(), post: vi.fn() };
+
+    const res = makeRes(erp);
+    await call(res, "dashboard");
+
+    expect(res.statusCode).toBe(200);
+    expect(res.body?.data.assignments).toEqual([{ id: "a1", title: "Saved assignment" }]);
+    expect(res.body?.data.reflection).toBeDefined();
+    expect(erp.get).not.toHaveBeenCalled();
+    // The cached object must be untouched.
+    expect(cached).toEqual({ dashboard: { name: "Joe" }, attendance: { pct: 80 } });
+  });
+
+  it("returns 502 pointing to Settings when the ERP rejects everything", async () => {
+    const erp = {
+      get: vi.fn().mockRejectedValue(new Error("login rejected")),
+      post: vi.fn().mockRejectedValue(new Error("login rejected")),
+    };
+
+    const res = makeRes(erp);
+    await call(res, "all");
+
+    expect(res.statusCode).toBe(502);
+    expect(res.body?.status).toBe("error");
+    expect(res.body?.message).toMatch(/Settings/);
+  });
+
+  it("returns 502 for a single section that fails", async () => {
+    const erp = {
+      get: vi.fn().mockRejectedValue(new Error("down")),
+      post: vi.fn().mockRejectedValue(new Error("down")),
+    };
+
+    const res = makeRes(erp);
+    await call(res, "fees");
+
+    expect(res.statusCode).toBe(502);
+  });
+
+  it("keeps working with partial data when only some sections fail", async () => {
+    const erp = {
+      get: vi.fn(async () => ({ data: {} })),
+      post: vi.fn(async () => ({ data: {} })),
+    };
+    // Make the fees section fail on its own.
+    erp.get.mockImplementation(async (url: string) => {
+      if (url.includes("FeePaid") || url.includes("feePaid")) throw new Error("fees down");
+      return { data: {} };
+    });
+
+    const res = makeRes(erp);
+    await call(res, "all");
+
+    expect(res.statusCode).toBe(200);
+    expect(res.body?.data.registrations).toBeDefined();
+    expect(res.body?.unavailable.every((u: { message: string }) => !/LRMS endpoint/.test(u.message))).toBe(true);
+  });
+
+  it("rejects unknown sections", async () => {
+    const res = makeRes({ get: vi.fn(), post: vi.fn() });
+    await call(res, "secrets");
+    expect(res.statusCode).toBe(404);
+  });
+});
diff --git a/backend/tests/portal-v2.service.test.ts b/backend/tests/portal-v2.service.test.ts
new file mode 100644
index 0000000..89ff64b
--- /dev/null
+++ b/backend/tests/portal-v2.service.test.ts
@@ -0,0 +1,97 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  PortalV2Service,
+  SECTION_UNAVAILABLE_MESSAGE,
+} from "../src/services/portal-v2.service.js";
+import { erpResponseCache } from "../src/lib/erp-cache.js";
+
+function recordingErp() {
+  const calls: string[] = [];
+  const key = (method: string, url: string, body?: unknown) =>
+    `${method} ${url} ${body instanceof URLSearchParams ? body.toString() : ""}`.trim();
+
+  const erp = {
+    calls,
+    get: vi.fn(async (url: string) => {
+      calls.push(key("GET", url));
+      return { data: {} };
+    }),
+    post: vi.fn(async (url: string, body?: unknown) => {
+      calls.push(key("POST", url, body));
+      return { data: {} };
+    }),
+  };
+  return erp;
+}
+
+beforeEach(() => {
+  erpResponseCache.clear();
+  vi.spyOn(console, "error").mockImplementation(() => undefined);
+});
+afterEach(() => vi.restoreAllMocks());
+
+describe("PortalV2Service", () => {
+  it("never asks the ERP for the same thing twice in one request", async () => {
+    const erp = recordingErp();
+
+    await new PortalV2Service(erp).get("all");
+
+    // Before memoization the profile alone was fetched three times, the dashboard
+    // two or three times, and the attendance summary twice.
+    expect(erp.calls.length).toBeGreaterThan(0);
+    expect(new Set(erp.calls).size).toBe(erp.calls.length);
+  });
+
+  it("serves a section from cache on the next request and skips the ERP", async () => {
+    const first = recordingErp();
+    await new PortalV2Service(first, { cacheScope: "u1" }).get("registrations");
+    const callsAfterFirst = first.calls.length;
+    expect(callsAfterFirst).toBeGreaterThan(0);
+
+    const second = recordingErp();
+    const result = await new PortalV2Service(second, { cacheScope: "u1" }).get("registrations");
+
+    expect(second.calls).toHaveLength(0);
+    expect(result.unavailable).toEqual([]);
+  });
+
+  it("refresh bypasses the cache and stores the new value", async () => {
+    await new PortalV2Service(recordingErp(), { cacheScope: "u1" }).get("registrations");
+
+    const refreshed = recordingErp();
+    await new PortalV2Service(refreshed, { cacheScope: "u1", refresh: true }).get("registrations");
+    expect(refreshed.calls.length).toBeGreaterThan(0);
+
+    const after = recordingErp();
+    await new PortalV2Service(after, { cacheScope: "u1" }).get("registrations");
+    expect(after.calls).toHaveLength(0);
+  });
+
+  it("keeps each user's cached sections separate", async () => {
+    await new PortalV2Service(recordingErp(), { cacheScope: "u1" }).get("registrations");
+
+    const other = recordingErp();
+    await new PortalV2Service(other, { cacheScope: "u2" }).get("registrations");
+
+    expect(other.calls.length).toBeGreaterThan(0);
+  });
+
+  it("does not cache a failed section and hides upstream error text", async () => {
+    const failing = recordingErp();
+    failing.get.mockRejectedValue(
+      new Error('LRMS endpoint "/ajax/secret.jsp" returned HTML'),
+    );
+
+    const result = await new PortalV2Service(failing, { cacheScope: "u1" }).get("registrations");
+
+    expect(result.data.registrations).toBeNull();
+    expect(result.unavailable).toEqual([
+      { section: "registrations", message: SECTION_UNAVAILABLE_MESSAGE },
+    ]);
+    expect(JSON.stringify(result)).not.toContain("secret.jsp");
+
+    const recovered = recordingErp();
+    const again = await new PortalV2Service(recovered, { cacheScope: "u1" }).get("registrations");
+    expect(again.unavailable).toEqual([]);
+  });
+});
diff --git a/docs/api-v2.md b/docs/api-v2.md
index 846443b..59ab992 100644
--- a/docs/api-v2.md
+++ b/docs/api-v2.md
@@ -11,6 +11,14 @@ The v2 portal API reads data from the authenticated student's LRMS session. It d
 - `POST /api/v2/portal/credentials` accepts `{ "password": "..." }` to verify and save a password already changed on the official LRMS site.
 - `PUT /api/v2/portal/password` accepts `{ "currentPassword": "...", "newPassword": "..." }` and changes the LRMS password through its `changepassword.jsp` endpoint. The saved encrypted credential is replaced only after LRMS reports success.
 
+## Caching, refresh and errors
+
+- Each section is cached per user (`profile` 30 min, `registrations` 10 min, `dashboard` and `academics` and `fees` 5 min, `attendance` 2 min). Add `?refresh=1` to skip the cache and store fresh data.
+- Identical LRMS calls inside one request are made once. The student profile alone is needed by attendance, academics and fees.
+- If every requested section fails, the API returns `502` with a message that points the student to Settings, because the usual cause is a changed ERP password. Partial failures still return `200` with the failed sections listed in `unavailable`.
+- `unavailable[].message` is always a generic string. Details are only in the server log.
+- `/api/v2/portal/credentials` and `/api/v2/portal/password` are limited to 10 requests per minute per IP.
+
 Successful read responses have `{ "status": "success", "data": { ... }, "unavailable": [] }`. In the all-sections response, an unavailable section is `null` and its safe error message is listed in `unavailable`; successful sections remain available.
 
 ## Sections and LRMS sources
