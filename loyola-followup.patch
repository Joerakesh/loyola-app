-  private async settle(name: string, loader: Loader): Promise<{ data: unknown; error?: string }> {
+  private async settle(
+    name: string,
+    loader: Loader,
+  ): Promise<{ data: unknown; error?: string }> {
     try {
-      return { data: await loader() };
+      return { data: await this.cached(name as PortalSection, loader) };
     } catch (error) {
-      // Keep student records out of logs and return a safe section-level error.
+      // Details stay in the server log; clients only get a generic message.
       console.error(
         `[Portal v2] ${name} unavailable:`,
         error instanceof Error ? error.message : "LRMS request failed",
       );
-      return {
-        data: null,
-        error: error instanceof Error ? error.message : "LRMS request failed",
-      };
+      return { data: null, error: SECTION_UNAVAILABLE_MESSAGE };
     }
   }
+
+  private async cached(name: PortalSection, loader: Loader): Promise<unknown> {
+    const { cacheScope, refresh } = this.options;
+    if (!cacheScope) return loader();
+
+    const key = `${cacheScope}:v2:${name}`;
+    if (refresh) erpResponseCache.delete(key);
+
+    const body = await erpResponseCache.readThrough(
+      key,
+      V2_SECTION_TTL_MS[name],
+      async () => ({ status: "success", data: await loader() }),
+    );
+
+    return body.data;
+  }
 }
