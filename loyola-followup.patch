diff --git a/backend/src/lib/memoized-requester.ts b/backend/src/lib/memoized-requester.ts
new file mode 100644
index 0000000..76b32a6
--- /dev/null
+++ b/backend/src/lib/memoized-requester.ts
@@ -0,0 +1,46 @@
+import type { LRMSRequester } from "../upstream/lrms.client.js";
+
+function bodyKey(body: unknown): string {
+  if (body === undefined || body === null) return "";
+  if (body instanceof URLSearchParams) return body.toString();
+  return JSON.stringify(body);
+}
+
+/**
+ * Makes identical ERP calls within one logical request share a single result.
+ *
+ * Several portal sections need the same data (the student profile alone is used
+ * by attendance, academics and fees), and without this each one fetched it again.
+ * Failures are not remembered, so a retry still reaches the ERP.
+ *
+ * Read-only use only: never wrap a client that performs writes such as a
+ * password change.
+ */
+export function memoizeRequester(inner: LRMSRequester): LRMSRequester {
+  const calls = new Map<string, Promise<{ data: unknown }>>();
+
+  const run = <T>(key: string, call: () => Promise<{ data: T }>) => {
+    let pending = calls.get(key) as Promise<{ data: T }> | undefined;
+
+    if (!pending) {
+      pending = call().catch((error: unknown) => {
+        calls.delete(key);
+        throw error;
+      });
+      calls.set(key, pending);
+    }
+
+    return pending;
+  };
+
+  return {
+    get<T = unknown>(url: string) {
+      return run<T>(`GET ${url}`, () => inner.get<T>(url));
+    },
+    post<T = unknown>(url: string, data?: unknown) {
+      return run<T>(`POST ${url} ${bodyKey(data)}`, () =>
+        inner.post<T>(url, data),
+      );
+    },
+  };
+}
