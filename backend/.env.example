PORT=3000
NODE_ENV=development

LRMS_BASE_URL=https://lrms.loyolacollege.edu/studenterp

# How long one LRMS login is reused across requests (in-memory per user).
LRMS_SESSION_TTL_SECONDS=2700

# Public Loyola College website scraper (/api/v1/website/*)
WEBSITE_BASE_URL=https://www.loyolacollege.edu
WEBSITE_CACHE_TTL_SECONDS=300

# Academic calendar scraper + Mongo sync (/api/v1/calendar)
CALENDAR_BASE_URL=https://www.loyolacollege.edu/acnew.php
CALENDAR_SYNC_MONTHS_BEFORE=2
CALENDAR_SYNC_MONTHS_AFTER=10
CALENDAR_STALE_AFTER_SECONDS=21600
CALENDAR_SYNC_INTERVAL_MINUTES=360

SESSION_SECRET=change-this-in-production
ERP_CREDENTIALS_ENCRYPTION_KEY=generate-a-64-char-hex-key

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=loyola_app

FIREBASE_PROJECT_ID=loyola-app-803a6
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# Test-only (used by scripts/test-login.ts): Firebase Console → Project settings → General → Web API key
FIREBASE_WEB_API_KEY=
BACKEND_URL=http://localhost:5000